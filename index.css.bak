* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  background: linear-gradient(135deg, #182742 0%, #3D1A2E 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 20px;
  gap: 18px;
}

.container {
  background: white;
  border-radius: 12px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.2);
  max-width: 450px;
  width: 100%;
  padding: 40px;
}

.logo {
  display: block;
  margin: 0 auto 20px auto;
  width: 80px;
  height: 80px;
  object-fit: contain;
}

h1 {
  color: #333;
  margin-bottom: 10px;
  font-size: 28px;
}

.subtitle {
  color: #666;
  margin-bottom: 30px;
  font-size: 14px;
}

.form-group {
  margin-bottom: 20px;
}

label {
  display: block;
  margin-bottom: 8px;
  color: #333;
  font-weight: 500;
  font-size: 14px;
}

input {
  width: 100%;
  padding: 12px;
  border: 2px solid #e0e0e0;
  border-radius: 6px;
  font-size: 14px;
  transition: border-color 0.3s;
}

input:focus {
  outline: none;
  border-color: #667eea;
}

.btn {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
  margin-top: 10px;
}

.btn-primary {
  background: #182742;
  color: white;
}

.btn-primary:hover:not(:disabled) {
  background: #3D1A2E;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.btn-secondary {
  background: #f5f5f5;
  color: #333;
}

.btn-secondary:hover {
  background: #e0e0e0;
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-link {
  background: none;
  border: none;
  color: #182742;
  cursor: pointer;
  text-decoration: underline;
  font-size: 14px;
  margin-top: 15px;
}

.message {
  padding: 12px;
  border-radius: 6px;
  margin-bottom: 20px;
  font-size: 14px;
}

.message.error {
  background: #fee;
  color: #c33;
  border: 1px solid #fcc;
}

.message.success {
  background: #efe;
  color: #3c3;
  border: 1px solid #cfc;
}

.hidden {
  display: none !important;
}

.user-info {
  background: #f8f9fa;
  padding: 15px;
  border-radius: 6px;
  margin-bottom: 20px;
}

.user-info p {
  margin: 5px 0;
  color: #555;
  font-size: 14px;
}

.user-info strong {
  color: #333;
}

.logout-btn {
  background: #dc3545;
  color: white;
  padding: 8px 16px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12px;
  margin-top: 10px;
}

.logout-btn:hover {
  background: #c82333;
}

.site-footer {
  margin-top: 6px;
  text-align: center;
  color: #e5e5e5;
  max-width: 450px;
  width: 100%;
}

.site-footer nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}

.site-footer a {
  color: #f5f5f5;
  text-decoration: none;
  font-size: 13px;
}

.site-footer a:hover {
  text-decoration: underline;
}

/* ============================================================================
   Banks listing — dashboard bank cards, badges, action buttons
   ============================================================================ */

.section-heading {
  margin-bottom: 4px;
}

.bank-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.bank-card {
  margin-bottom: 8px;
  padding: 12px 16px;
  background: #f7f9fc;
  border: 1px solid #e3e7ef;
  border-radius: 8px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.bank-card-left {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  flex: 1;
  min-width: 0;
}

.bank-icon {
  font-size: 18px;
  line-height: 1.4;
}

.bank-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.bank-name {
  font-weight: 600;
  color: #333;
  font-size: 15px;
}

.bank-meta {
  font-size: 12px;
  color: #888;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* Connection status indicators */
.conn-status {
  font-size: 11px;
  font-weight: 500;
}

.conn-status-linked {
  color: #28a745;
}

.conn-status-converted {
  color: #ffc107;
}

.conn-status-manual {
  color: #6c757d;
}

/* Sync badges — only shown for linked banks */
.sync-badges {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: 2px;
}

.sync-badge {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 500;
  white-space: nowrap;
}

.sync-badge-transactions {
  background: #e8f5e9;
  color: #2e7d32;
  border: 1px solid #c8e6c9;
}

.sync-badge-investments {
  background: #e0f7fa;
  color: #00838f;
  border: 1px solid #b2ebf2;
}

/* Bank card action buttons */
.bank-card-actions {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.bank-btn {
  border: none;
  border-radius: 6px;
  padding: 6px 10px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
  transition: opacity 0.2s;
}

.bank-btn:hover {
  opacity: 0.85;
}

.bank-btn-refresh {
  background: #28a745;
  color: #fff;
}

.bank-btn-relink {
  background: #17a2b8;
  color: #fff;
}

.bank-btn-disconnect {
  background: #dc3545;
  color: #fff;
}

.banks-empty-state {
  color: #666;
  font-style: italic;
  margin-bottom: 8px;
}

.banks-error {
  color: #c33;
}

/* Connect buttons row */
.connect-buttons {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.token-label {
  font-weight: 600;
}

.token-label-txn {
  color: #4caf50;
}

.token-label-inv {
  color: #20c9e0;
}

.connect-note {
  margin-top: 10px;
  font-size: 0.9em;
  color: #666;
}
