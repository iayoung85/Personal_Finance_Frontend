/* Inherits from transactions.css */

/* Flat list layout for investment accounts */
.account-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.item-group {
  display: flex;
  gap: 8px;
  align-items: stretch;
}

.accounts-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background: #f9f9f9;
  border-bottom: 1px solid #e9e9e9;
  min-height: 40px;
}

.account-row label {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0;
  flex: 1;
}

.account-row .bank-name {
  font-weight: 500;
  color: #333;
  min-width: 150px;
}

.account-row .account-name {
  color: #666;
  flex: 1;
}

.item-group .activate-btn {
  align-self: stretch;
  min-width: 100px;
  background-color: #28a745;
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  transition: background-color 0.2s;
  white-space: nowrap;
}

.item-group .activate-btn:hover {
  background-color: #218838;
}

.item-group .activate-btn:disabled {
  background-color: #ccc;
  cursor: not-allowed;
}

.holding-group-header {
  background-color: #f8f9fa;
  font-weight: bold;
  cursor: pointer;
}

.holding-group-header:hover {
  background-color: #e9ecef;
}

.holding-detail-row {
  background-color: #fff;
  display: none; /* Hidden by default */
}

.holding-detail-row.expanded {
  display: table-row;
}

.holding-detail-row td {
  padding-left: 40px; /* Indent detail rows */
  color: #555;
  font-size: 0.95em;
}

.expand-icon {
  display: inline-block;
  width: 20px;
  text-align: center;
  transition: transform 0.2s;
}

.expanded .expand-icon {
  transform: rotate(90deg);
}

.positive-gain {
  color: #28a745;
}

.negative-gain {
  color: #dc3545;
}

.account-status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px;
  border-bottom: 1px solid #eee;
}

.account-status-item:last-child {
  border-bottom: none;
}

.status-badge {
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: bold;
}

.status-active {
  background-color: #d4edda;
  color: #155724;
}

.status-inactive {
  background-color: #f8d7da;
  color: #721c24;
}
/* Action bar above table */
.action-bar {
  display: flex;
  gap: 10px;
  align-items: center;
  margin: 20px 0;
  padding: 12px;
  background: #f9f9f9;
  border-radius: 4px;
  flex-wrap: wrap;
}

.action-bar button {
  padding: 8px 12px;
  font-size: 14px;
}

.action-bar .export-buttons {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}